root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_style = space
indent_size = 4

[*.toml]
indent_style = space
indent_size = 4

[*.json]
indent_style = space
indent_size = 2

[*.{html,css,js}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
